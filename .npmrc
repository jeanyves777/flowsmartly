# zod v3<->v4 peer conflict (@anthropic-ai/claude-agent-sdk peers zod@^4, root
# uses zod@^3) — allow the install to proceed instead of hard-failing on peers.
legacy-peer-deps=true

# Quieter, faster CI/VPS installs.
fund=false
audit=false

# NOTE: changing this file changes the deploy's dependency signature, which forces
# scripts/deploy-vps.sh to run `npm install` on the next deploy. That is intentional
# here: the VPS node_modules was missing lenis/gsap because install kept getting
# skipped — this bump forces one clean reinstall to repair it.
