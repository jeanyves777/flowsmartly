
# ── Legacy shutdown (V5 greenfield) ────────────────────────────────────────
# This backend is a disposable beta being replaced. Both switches default to
# OFF and must stay off. Re-enabling marketing email requires a working
# unsubscribe route and suppression behaviour FIRST — setting the flag without
# them is a compliance decision, not a configuration one.
LEGACY_MARKETING_SEND_ENABLED=false
LEGACY_MARKETING_TEST_ALLOWLIST=
LEGACY_ADS_MUTATIONS_ENABLED=false
