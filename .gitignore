tsconfig.tsbuildinfo

# SQLite database
prisma/*.db
prisma/*.db-journal

# User-generated uploads (videos, images)
public/uploads/

.next-build.tar.gz
next-build.zip

# Docker model files (symlinks break Windows builds)
docker/flow-ai/models/

