# Environment variables
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build outputs
.next/
out/
dist/
build/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Local scratch dir (screenshots, one-off scripts, logs) — never commit
tmp/

# Local caches
.cache/

# Claude Code
.claude/

# ML model weights & AI models
gfpgan/
docker/flow-ai/models/
docker/flow-ai/onnx-models/

# Windows artifacts
nul

# TypeScript build info
tsconfig.tsbuildinfo

# SQLite database
prisma/*.db
prisma/*.db-journal

# User-generated uploads (videos, images)
public/uploads/

.next-build.tar.gz
next-build.zip

# Docker model files (symlinks break Windows builds)
docker/flow-ai/models/

# Local smoke-test scratch outputs (HTML designer pipeline)
tmp-smoke-test.html
tmp-smoke-test.png
.secrets/

# Service account keys (Google Play, Google Cloud, etc.) — never commit
*-service-account.json
play-service-account.json
flowsmartly-*.json
google-services.json
GoogleService-Info.plist

# MediaPipe WASM is copied from node_modules at build time (next.config.ts), not committed
public/mediapipe/wasm/

# Windows PowerShell module cache, written into the repo when LOCALAPPDATA is unset
Microsoft/

# Studio thumbnail intermediates. The DERIVED, referenced files are committed:
# Clone_Yourself/*.webp (clone-workspace.tsx) and _training_thumbnail/<semantic>.png
# (brief-sheet.tsx). These PNG intermediates are 41 MB, nothing references them, and
# public/ is served — same reasoning as apps/v5 assets/images/v5cut/.
public/Studio_Menus_Thumnail/Clone_Yourself/clone-*.png
public/Studio_Menus_Thumnail/_training_thumbnail/ChatGPT Image*.png

# Derived at build time by scripts/prisma-production-schema.mjs from prisma/schema.prisma.
# Never edited by hand and never committed: a committed copy of a 6,542-line schema
# differing in one line would drift, and the drift would surface in production.
prisma/generated/
qa-shots/
qa-typography-*.json
scripts/vendor/
